# PostgreSQL connection string
# Local (compose maps host 15432 → container 5432). In Docker/Coolify use the service hostname:
# DATABASE_URL=postgresql://ranked:ranked@postgres:5432/ranked_choice
DATABASE_URL=postgresql://ranked:ranked@localhost:15432/ranked_choice

# Long random secret used for HMAC email hashing, email encryption, and sessions (min 32 chars)
SERVER_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public URL of the app (used in magic links)
APP_URL=http://localhost:3000

# When true, trust X-Forwarded-For / X-Real-IP from Coolify Traefik
TRUST_PROXY=false

# Local/dev only: allow voting from outside Brazil. Leave unset on Coolify.
ALLOW_NON_BR=true

# Optional ISO datetime when voting closes (empty = open)
# VOTING_CLOSES_AT=2026-12-31T23:59:59-03:00

# Local `npm run dev` sends to MailHog (SMTP). Inbox: http://localhost:8025
# Start it with: docker compose --profile dev up -d mailhog
# If 1025 or 8025 is already taken, set the same host port on SMTP_PORT and MAILHOG_SMTP_PORT.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Resend — production only (https://resend.com/api-keys).
# Ignored while NODE_ENV is not production. The from address must use a verified domain.
# On Prisma Compute these are project environment variables (SERVER_SECRET and
# RESEND_API_KEY as secrets). The database URL is provisioned by the module;
# do not set DATABASE_URL there.
RESEND_API_KEY=
RESEND_FROM=Enquete Ranqueada <acesso@tortrad.com.br>
