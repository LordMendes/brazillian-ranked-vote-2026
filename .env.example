# PostgreSQL connection string
# Local (compose maps host 15432 → container 5432). In Docker/Coolify use the service hostname:
# DATABASE_URL=postgresql://ranked:ranked@postgres:5432/ranked_choice?schema=public
DATABASE_URL=postgresql://ranked:ranked@localhost:15432/ranked_choice?schema=public

# Long random secret used for HMAC email hashing, email encryption, and sessions (min 32 chars)
SERVER_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public URL of the app (used in magic links)
APP_URL=http://localhost:3000

# When true, trust X-Forwarded-For / X-Real-IP from Coolify Traefik
TRUST_PROXY=false

# Local/dev only: allow voting from outside Brazil. Leave unset on Coolify.
ALLOW_NON_BR=true

# Optional ISO datetime when voting closes (empty = open)
# VOTING_CLOSES_AT=2026-12-31T23:59:59-03:00

# Resend — https://resend.com/api-keys
# onboarding@resend.dev only delivers to the Resend account email.
# For everyone else, verify a domain and set RESEND_FROM to that address.
RESEND_API_KEY=
RESEND_FROM=Enquete Ranqueada <onboarding@resend.dev>
